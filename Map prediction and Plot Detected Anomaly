      "source": [
        "## 9. Time-series Window Creation\n"
      ],
      "metadata": {
        "id": "lejz-8RZTrLl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "WINDOW_SIZE=48\n",
        "def create_window(values,window_size):\n",
        "  window=[]\n",
        "  for i in range(len(values)-window_size +1):\n",
        "    window.append(values[i:i+window_size])\n",
        "  return np.array(window)\n",
        "\n",
        "x_train=create_window(scaled_train,WINDOW_SIZE)\n",
        "x_test=create_window(scaled_test,WINDOW_SIZE)\n",
        "\n",
        "\n",
        "print(\"x_train shape: \",x_train.shape)\n",
        "print(\"x_test shape: \",x_test.shape)\n"
      ],
